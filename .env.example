# Copiar a .env y ajustar según el entorno.
DB_HOST=localhost
DB_PORT=5432
DB_USER=skyrouter
DB_PASSWORD=skyrouter
DB_NAME=skyrouter
DB_POOL_MAX=20

PORT=3000

# Usado por tests/stress/concurrencyTest.js para apuntar al servidor Express.
BASE_URL=http://localhost:3000

# SCRUM-49: firma/verifica los JWT emitidos por POST /api/auth/login.
# Generar uno propio por entorno, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# authController.js falla al arrancar si esta variable falta (a propósito:
# nunca debe correr con un secreto ausente/predecible).
JWT_SECRET=cambiar-por-un-secreto-propio-largo-y-aleatorio

# Opcionales (HU-02/SCRUM-8): ambos tienen un valor de negocio por defecto en
# el código si no se definen (15 minutos / cada minuto). Solo existen para
# poder acortarlos en pruebas manuales de la expiración automática sin
# recompilar, p. ej. MINUTOS_EXPIRACION_BLOQUEO_ASIENTO=1 y
# CRON_EXPIRACION_BLOQUEOS="*/15 * * * * *" (node-cron admite el campo
# opcional de segundos).
# MINUTOS_EXPIRACION_BLOQUEO_ASIENTO=15
# CRON_EXPIRACION_BLOQUEOS=* * * * *
